{
  "name": "web-admin",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "start": "pnpm run generate:openapi && ng serve",
    "build": "pnpm run generate:openapi && ng build",
    "watch": "pnpm run generate:openapi && ng build --watch --configuration development",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "pnpm run generate:openapi && pnpm run check:i18n && ng test"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "yaml": "^2.9.0"
  }
}