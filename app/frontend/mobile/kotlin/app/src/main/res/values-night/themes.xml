<?xml version="1.0" encoding="utf-8"?>
<!--
  The same theme when the system is in dark mode. Its window background is the app's dark
  background (DarkBackground in ui/theme/Theme.kt), so a cold start in dark mode does not flash
  white before Compose draws its first frame. On Android 12 and later the splash screen takes
  this colour too.
-->
<resources>
    <style name="Theme.KApp" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night_background</item>
    </style>
</resources>
