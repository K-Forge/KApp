    <!--
      The semester card counts credits, which is what GET /api/semaphore/me/summary returns. Only
      the second line of it counts courses.
    -->
    <plurals name="home_semester_courses">
        <item quantity="one">%1$d materia en curso</item>
        <item quantity="other">%1$d materias en curso</item>
    </plurals>
    <plurals name="home_credits_passed">
        <item quantity="one">%1$d aprobado</item>
        <item quantity="other">%1$d aprobados</item>
    </plurals>
    <plurals name="home_credits_in_progress">
