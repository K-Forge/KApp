<?xml version="1.0" encoding="utf-8"?>
<!--
  Interface strings are in Spanish, like the mockups in docs/design/mobile/. Repository
  documentation and code comments stay in English, as AGENTS.md asks.

  The institutional domain is not here: a resource value starting with "@" is read as a
  reference. It lives in LoginViewModel.kt as INSTITUTIONAL_DOMAIN.
-->
<resources>
