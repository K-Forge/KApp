<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>co.edu.konradlorenz.kapp</groupId>
    <artifactId>microservices-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>KApp Microservices</name>
    <description>Microservices backend for KApp - Konrad Lorenz</description>

    <modules>
        <module>common</module>
        <module>discovery-server</module>
        <module>api-gateway</module>
        <module>auth-service</module>
        <module>user-service</module>
        <module>semaphore-service</module>
        <module>schedule-service</module>
        <module>map-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
          Spring Cloud 2025.0.x is the release train for Boot 3.5.x.
          Do not move to 2025.1.x: that train targets Boot 4.0 / Spring Framework 7.
        -->
        <spring-cloud.version>2025.0.3</spring-cloud.version>

        <!-- springdoc 2.x is the Boot 3.x line; 3.x targets Boot 4. -->
        <springdoc.version>2.9.0</springdoc.version>

        <!--
          Mongock provides versioned MongoDB migrations, distributed locking and an
          audit trail - the equivalent of Flyway, which this project never had.
          Artifact must be mongock-springboot-v3 (Spring Boot 3), not mongock-springboot.
        -->
        <mongock.version>5.5.1</mongock.version>

        <testcontainers.version>1.21.4</testcontainers.version>

        <!--
          CSV parsing for the bulk pensum import. A dependency rather than a hand-rolled
          split(","): the files come out of spreadsheets, so quoted fields containing
          commas and newlines are the normal case, not the edge case, and getting that
          subtly wrong would corrupt a course name instead of failing loudly.
        -->
        <commons-csv.version>1.12.0</commons-csv.version>
    </properties>

    <!--
      Every version lives here so that parallel worktrees never edit this file.
      Service modules declare dependencies WITHOUT a <version>.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.mongock</groupId>
                <artifactId>mongock-bom</artifactId>
                <version>${mongock.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-csv</artifactId>
                <version>${commons-csv.version}</version>
            </dependency>

            <dependency>
                <groupId>co.edu.konradlorenz.kapp</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Inherited by every module. `common` is a plain library and overrides
              this with <skip>true</skip> so it is not repackaged into a fat jar,
              which would hide its classes under BOOT-INF/ from the services.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
