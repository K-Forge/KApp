{
  "name": "kapp",
  "version": "1.0.0",
  "private": true,
  "description": "KApp – University mobile app for Konrad Lorenz, powered by a Spring Boot microservices backend",
  "scripts": {
    "web:dev": "bunx serve app/frontend/web",
    "web:start": "bunx serve app/frontend/web -s -l 3000",
    "web:start:script": "bash scripts/start-frontend.sh",
    "microservices:start": "bash scripts/start-microservices.sh start",
    "microservices:stop": "bash scripts/start-microservices.sh stop",
    "microservices:status": "bash scripts/start-microservices.sh status",
    "dev:web": "bunx serve app/frontend/web",
    "start:web": "bunx serve app/frontend/web -s -l 3000",
    "start:microservices": "bash scripts/start-microservices.sh start",
    "start:frontend": "bash scripts/start-frontend.sh"
  },
  "devDependencies": {
    "serve": "^14.2.4"
  },
  "packageManager": "pnpm@10.33.0"
}
