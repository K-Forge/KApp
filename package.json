{
  "name": "kapp",
  "version": "1.0.0",
  "private": true,
  "description": "KApp – University mobile app for Konrad Lorenz, powered by a Spring Boot microservices backend",
  "scripts": {
    "microservices:start": "docker compose -f app/backend/microservices/docker-compose.yml --profile academic --profile map --profile dev up -d",
    "microservices:mock": "docker compose -f app/backend/microservices/docker-compose.yml --profile mock up -d",
    "microservices:status": "docker compose -f app/backend/microservices/docker-compose.yml --profile full --profile dev ps",
    "microservices:logs": "docker compose -f app/backend/microservices/docker-compose.yml logs -f --tail=60",
    "microservices:stop": "docker compose -f app/backend/microservices/docker-compose.yml --profile full --profile dev down",
    "prototype:serve": "pnpm exec serve app/frontend/web -s -l 3000"
  },
  "devDependencies": {
    "serve": "^14.2.4"
  },
  "packageManager": "pnpm@10.33.0"
}
