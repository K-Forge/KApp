# ─────────────────────────────────────────────────────────────
# KApp — Environment variables (example)
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored; never commit real credentials.
#
#   cp .env.example .env
#
# The microservices read these values through Spring property
# placeholders declared in each `application.properties`.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL 15+, hosted on Neon in the reference setup) ──
# Consumed by: auth-service, user-service, course-service, assignment-service
PGHOST=localhost
PGDATABASE=kapp
PGUSER=postgres
PGPASSWORD=
# `require` for managed/cloud PostgreSQL, `disable` for a local instance
PGSSLMODE=require

# ── Authentication ──
# Consumed by: auth-service (token issuing), api-gateway (token validation)
#
# IMPORTANT: tokens are signed with HS512. JJWT enforces a signing key of at
# least 64 bytes for that algorithm and throws `WeakKeyException` on startup
# if the value is shorter. Generate one with:
#
#   openssl rand -base64 96
#
# Both services must share the exact same secret.
JWT_SECRET=

# Token lifetime is not externalized: it is fixed at 86400000 ms (24 h) in
# `auth-service/src/main/resources/application.properties`.

# ── Web frontend ──
# Port used by `scripts/start-frontend.sh` (defaults to 3000)
PORT=3000
