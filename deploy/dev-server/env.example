# /opt/kapp/.env on a KApp dev server - mode 0600, owned by root. This file lists the names; the
# values never enter the repository. The five secrets are the ones in
# app/backend/microservices/.env on a laptop set up with docs/ATLAS-SETUP.md.

# Which branch the server follows, and its image tag: the branch in lower case, "/" as "-".
KAPP_DEV_BRANCH=feature/campus-map
KAPP_DEV_TAG=feature-campus-map

# The address people open the portal at, exactly: the gateway answers that origin only.
KAPP_DEV_URL=https://dev-host.example.ts.net

# 1 to publish the portal (443) and the gateway (8080) over HTTPS on the tailnet with
# `tailscale serve`. Leave it out on a host that publishes them some other way.
KAPP_DEV_TAILSCALE_SERVE=1

# The shared Atlas development cluster, one account per service, and the keys every stack shares.
MONGO_AUTH_URI=
MONGO_MAP_URI=
KAPP_JWT_PRIVATE_KEY=
KAPP_JWT_PUBLIC_KEY=
KAPP_INTERNAL_TOKEN=

# Optional. A host with room to spare can stop yielding to everything else.
# KAPP_DEV_OOM_SCORE_ADJ=1000
# KAPP_DEV_CPU_SHARES=128
# Another registry, or a fork's packages.
# KAPP_DEV_IMAGES=ghcr.io/k-forge/kapp
# KAPP_DEV_REPO=K-Forge/KApp
